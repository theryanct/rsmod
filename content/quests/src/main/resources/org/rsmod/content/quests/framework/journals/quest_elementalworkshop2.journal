done	<str>Search all crates on the ground floor and the catwalk of the workshop until you find the following. IMPORTANT: Be sure to read the Crane schematic and Lever schematic, or you will be unable to find all the pieces.</str>
done	
done	<str>On the north side of the catwalk use the Pipe on the broken piping.</str>
done	
done	<str>On the east side of the Ground floor use the cogs on the pins on the side of the machine that looks like a wind tunnel as shown.</str>
done	
done	<str>Pull the old lever to the right.</str>
done	
done	<str>On the south side place an elemental bar on the jig cart. (under the elemental claw)</str>
done	
done	<str>First, use the western lever (by the schematics crate) to raise the crane.</str>
done	
done	<str>Use the eastern lever to rotate the crane.</str>
done	
done	<str>Use the western lever twice to lower the crane into the lava and back up again.</str>
done	
done	<str>Use the eastern lever to rotate the crane over the cart.</str>
done	
done	<str>Use the western lever twice to lower the bar onto the cart and release it.</str>
done	
done	<str>Pull the lever just north of the claw controls to move the cart.</str>
done	
done	<str>Pull the western-most lever - in front of the press station - to flatten the bar once the cart has stopped.</str>
done	
done	<str>Pull the yellow sign lever again to move the cart to the next station.</str>
done	
done	<str>Pull the northern-most lever.</str>
done	
done	<str>Turn the corkscrew lever twice.</str>
done	
done	<str>Pull the northern-most lever again.</str>
done	
done	<str>Turn the west water valve twice so that the valve opens and closes. The tank will fill.</str>
done	
done	<str>Turn the east water valve twice so that the valve opens and closes. The tank will empty.</str>
done	
done	<str>Pull the northern-most lever.</str>
done	
done	<str>Turn the corkscrew lever twice.</str>
done	
done	<str>Pull the northern-most lever to close the door.</str>
done	
done	<str>Pull the yellow sign lever again.</str>
done	
done	<str>Pull the east lever</str>
done	
done	<str>Pull the east lever again to stop the fan.</str>
done	
done	<str>Pull the yellow sign lever again.</str>
done	
done	<str>Take-from the jig to get a primed bar.</str>
done	
done	<str>Head down the stairs to the north-west.</str>
done	
done	<str>Go through the east door.</str>
done	
done	<str>Use your primed bar with the extractor gun.</str>
done	
done	<str>Operate the Extractor hat with the bar placed under the gun.</str>
done	
done	<str>Take-from the extractor gun to get a primed mind bar.</str>
done	
done	<str>Go up both spiral stairs</str>
done	
done	<str>Use your primed mind bar on the workbench to smith a mind helmet.</str>
done	
done	<col=ff0000>QUEST COMPLETE!</col>
