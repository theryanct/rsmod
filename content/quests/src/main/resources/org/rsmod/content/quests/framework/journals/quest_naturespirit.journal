before	<col=000080>Talk to <col=800000>Drezel</col> in the basement of the <col=800000>Paterdomus Temple</col> by the northern end of the <col=800000>River Salve</col>.</col>
before	
before	<col=000080>Difficulty:</col>
before	<col=800000>Intermediate</col>
