# Generated from the OSRS Wiki page "The Golem/Quick guide" by tools/quests/journals_from_wiki.py; set a step's stage to pin it.
before	<col=000080>Talk to the <col=800000>clay golem</col> in the ruins of <col=800000>Uzer</col>, east of the <col=800000>Shantay Pass</col> in the <col=800000>Kharidian Desert</col>.</col>
before	
before	<col=000080>Difficulty:</col>
before	<col=800000>Intermediate</col>
before	<col=000080>Length:</col>
before	<col=800000>Short</col>
before	
before	<col=000080>Requirements:</col>
req	Level 20 Crafting
req	Level 25 Thieving
step	1	-	Quick guide step 1
line	<col=000080>Travel to the <col=800000>Ruins of Uzer</col> via the <col=800000>necklace of passage</col> teleport to <col=800000>Eagle's Eyrie</col> and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</col>
step	2	-	Quick guide step 2
line	<str>Travel to the Ruins of Uzer via the necklace of passage teleport to Eagle's Eyrie and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</str>
line	
line	<col=000080>Pick up and read the <col=800000>Letter</col> west of the broken <col=800000>clay golem</col></col>
step	3	-	Quick guide step 3
line	<str>Travel to the Ruins of Uzer via the necklace of passage teleport to Eagle's Eyrie and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</str>
line	
line	<str>Pick up and read the Letter west of the broken clay golem</str>
line	
line	<col=000080>Talk to the golem.</col>
step	4	-	Quick guide step 4
line	<str>Travel to the Ruins of Uzer via the necklace of passage teleport to Eagle's Eyrie and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</str>
line	
line	<str>Pick up and read the Letter west of the broken clay golem</str>
line	
line	<str>Talk to the golem.</str>
line	
line	<col=000080>Use four <col=800000>soft clay</col> on the golem. If you chose to bring a pickaxe and a <col=800000>bracelet of clay</col>, <col=800000>clay rocks</col> can be found to the north-west, near the shore. The phoenix can be found there as well.</col>
step	5	-	Quick guide step 5
line	<str>Travel to the Ruins of Uzer via the necklace of passage teleport to Eagle's Eyrie and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</str>
line	
line	<str>Pick up and read the Letter west of the broken clay golem</str>
line	
line	<str>Talk to the golem.</str>
line	
line	<str>Use four soft clay on the golem. If you chose to bring a pickaxe and a bracelet of clay, clay rocks can be found to the north-west, near the shore. The phoenix can be found there as well.</str>
line	
line	<col=000080>Talk to the golem again.</col>
step	6	-	Quick guide step 6
line	<str>Travel to the Ruins of Uzer via the necklace of passage teleport to Eagle's Eyrie and run south-east. You can alternatively use a fairy ring (DLQ) and go north-east.</str>
line	
line	<str>Pick up and read the Letter west of the broken clay golem</str>
line	
line	<str>Talk to the golem.</str>
line	
line	<str>Use four soft clay on the golem. If you chose to bring a pickaxe and a bracelet of clay, clay rocks can be found to the north-west, near the shore. The phoenix can be found there as well.</str>
line	
line	<str>Talk to the golem again.</str>
line	
line	<col=000080>Pick a <col=800000>black mushroom</col> near the stairs east of the golem before heading down (or downstairs at your right).</col>
step	7	-	Quick guide step 7
