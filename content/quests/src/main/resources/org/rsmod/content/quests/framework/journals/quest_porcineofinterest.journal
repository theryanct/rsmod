# Authored in OSRS journal style from the OSRS Wiki walkthrough (no Wiki journal transcript); stages pinned to the server's quest states.
before	<col=000080>I can start this quest by reading the notice board in <col=800000>Draynor Village</col>, behind <col=800000>Fortunato</col>'s wine shop.</col>
before	
before	<col=000080>Difficulty:</col>
before	<col=800000>Novice</col>
before	<col=000080>Length:</col>
before	<col=800000>Very Short</col>
