done	
done	<str>Jump south to the floorboards.</str>
done	
done	<str>Jump east to the floorboards.</str>
done	
done	<str>Go to the north-east corner of the room, push the wall and go across the gap.</str>
done	
done	<str>Crawl under the wall to the north.</str>
done	
done	<str>Go north to the second room, look on the west side, push the wall and walk across it.</str>
done	
done	<str>Climb down the ladder.</str>
done	
done	<str>Search the table next to the wall, open the trapdoor table, and climb into it.</str>
done	
done	<str>Climb up the shelf.</str>
done	
done	<str>Crawl under the wall to the east side.</str>
done	
done	<str>Jump to the floorboards to the east.</str>
done	
done	<str>Climb down the ladder.</str>
done	
done	<str>Search the pots near the eastern door to get a door key and use it to open the door.</str>
done	
done	<str>Climb up the ladder in the room to the east.</str>
done	
done	<str>Jump south to the floorboards.</str>
done	
done	<str>Go east, south, west and climb up the shelf.</str>
done	
done	<str>Climb up the ladder.</str>
done	
done	<str>Jump south again to the floorboards.</str>
done	
done	<str>Climb down the ladder.</str>
done	
done	<str>Go east through the rooms and walk across the washing line.</str>
done	
done	<str>Climb down the ladder.</str>
done	
done	<str>Push the wall to the north and walk across the floor.</str>
done	
done	<str>Climb up the shelf to the north.</str>
done	
done	<str>Climb down the shelf on the north-eastern side, below the floor.</str>
done	
done	<str>Jump to the floorboards to the north-west.</str>
done	
done	<str>Jump to the floorboards to the north.</str>
done	
done	<str>Go north-west and then east (around a gap in the floor) and jump to the floorboards.</str>
done	
done	<str>Climb up the ladder.</str>
done	
done	<str>Search the western wall to find a ladder top.</str>
done	
done	<str>Climb down the ladder you came up, then repair the nearby broken ladder using the ladder top. Then climb down the fixed ladder. You are now in sector three.</str>
done	
done	<str>Open the door and go north and slightly west, then north to a house with a fireplace in it. (go up the ladder if you need a knife)</str>
done	
done	<str>Go west through the door into the next room, then north out of the house until you see a barricade.</str>
done	
done	<str>Go east past the sickle logo and the house directly south should have a ladder inside. Climb up the ladder.</str>
done	
done	<str>Jump to the floorboards to the east.</str>
done	
done	<str>Climb down the stairs.</str>
done	
done	<str>Go south along the eastern side of the stairs. Search the wall. Use your knife on the wall, then push it.</str>
done	
done	<str>Press the decorated wall on the northern side.</str>
done	
done	<str>Open the lumpy rug (south-east square of the green rug).</str>
done	
done	<str>Climb down the trapdoor to enter the hideout.</str>
done	
done	<str>Run north and talk to Vertida Sefalatis.</str>
done	
done	<str>Travel back to Burgh de Rott.</str>
done	
done	<str>Talk to Veliaf Hurtz in the pub basement.</str>
done	
done	<str>Travel to the Paterdomus Temple (fairy ring CKS).</str>
done	
done	<str>Talk to Drezel in Paterdomus, underneath the temple.</str>
done	
done	<str>Take the west exit, past the monuments.</str>
done	
done	<str>Search the bush slightly south-west of the steps leading to the temple.</str>
done	
done	<str>Wait for the cutscene to finish.</str>
done	
done	<str>Return to speak with Drezel. He will give you runes to use Varrock Teleport.</str>
done	
done	<str>Teleport or travel to Varrock and talk to King Roald in the palace. The king will teleport you back to Paterdomus if you ask the right question.</str>
done	
done	<str>Travel back to Burgh de Rott.</str>
done	
done	<str>Talk to Veliaf Hurtz in the pub basement.</str>
done	
done	<str>Return to Meiyerditch and speak to a Vyrewatch.</str>
done	
done	<str>Talk to a Meiyerditch miner to get a pickaxe if you don't have one.</str>
done	
done	<str>Mine the daeyalt rocks on the walls until you get 15 daeyalt ore.</str>
done	
done	<str>Use all 15 ores on the mine cart, then talk to a Vampyre Juvinate.</str>
done	
done	<str>Run to the Myreque Hideout, marked on the map to the right. Follow the blue path from north to south.</str>
done	
done	<str>Go south through 3 doors and up the ladder.</str>
done	
done	<str>Jump to the floorboards to the east, climb down the stairs and enter the hideout.</str>
done	
done	<str>Talk to Vertida.</str>
done	
done	<str>Climb down the ladder, out the door, run south and climb over the wall rubble where you came in to Meiyerditch.</str>
done	
done	<str>Run south and climb up the floor.</str>
done	
done	<str>Run north up the slope and climb down the ladder.</str>
done	
done	<str>Search the rocky surface.</str>
done	
done	<str>Go north through the barricade.</str>
done	
done	<str>Climb up the ladder.</str>
done	
done	<str>Run north along the wall and climb up the ladder.</str>
done	
done	<str>Climb down the next ladder.</str>
done	
done	<str>Climb the castle wall to the north.</str>
done	
done	<str>Run west along the wall clockwise and talk to Safalaan. Make sure you have 4 free inventory spaces.</str>
done	
done	<str>Run west along the wall clockwise until you see a sickle logo on the floor of the wall you're walking on, on the north side of the castle.</str>
done	
done	<str>Use the papyrus on the charcoal for the first sketch.</str>
done	
done	<str>Run west anti-clockwise and do the same for the west sickle for the second sketch.</str>
done	
done	<str>Wait for the cutscene to finish.</str>
done	
done	<str>Run west anti-clockwise and do the same for the south sickle.</str>
done	
done	<str>Let Vanstrom attack you five times, which will knock you out.</str>
done	
done	<str>Go back and finish your final sketch.</str>
done	
done	<str>Talk to Sarius Guile if she didn't automatically talk to you when Vanstrom knocked you out.</str>
done	
done	<str>Speak to a nearby Vyrewatch and use the mine technique to get back to the base.</str>
done	
done	<str>Walk to the house directly south-west of the house with the ladder leading to the Myreque Hideout. It contains a fireplace and a portrait on its south wall.</str>
done	
done	<str>Use your knife on the fireplace for a message.</str>
done	
done	<str>Use your knife on the portrait for a large ornate key.</str>
done	
done	<str>Return to the Myreque Hideout.</str>
done	
done	<str>Talk to Safalaan. . Afterwards, give him the message.</str>
done	
done	<str>Exit the base, climb up the stairs, jump the gap, then climb down the ladder.</str>
done	
done	<str>Travel north towards the mine until you find a bright, red and yellow tapestry inside a building adjacent to the Eastern city wall.</str>
done	
done	<str>Slash the tapestry with your knife.</str>
done	
done	<str>Walk through it and use the large ornate key on the statue.</str>
done	
done	<str>Open the door, climb-down the staircase and use Telekinetic Grab on Haemalchemy volume 1.</str>
done	
done	<str>Return to the base and talk to Safalaan one final time and give him Haemalchemy volume 1.</str>
done	
done	<str>Travel back to Burgh de Rott.</str>
done	
done	<str>Talk to Veliaf Hurtz in the pub basement.</str>
