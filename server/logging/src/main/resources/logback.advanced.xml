<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} %M - %msg%n</pattern>
      <charset>utf8</charset>
    </encoder>
  </appender>

  <!-- Game-wide diagnostics (GameplayLog) in a rotating file, plus every WARN/ERROR in a second
       one. Turn diagnostics off by setting the "gameplay" logger level to OFF. -->
  <appender name="GAMEPLAY" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>.data/logs/gameplay.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>.data/logs/gameplay.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
    </rollingPolicy>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern>
      <charset>utf8</charset>
    </encoder>
  </appender>

  <appender name="GAMEPLAY_PROBLEMS" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <file>.data/logs/gameplay-problems.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>.data/logs/gameplay-problems.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
    </rollingPolicy>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{0} - %msg%n%ex</pattern>
      <charset>utf8</charset>
    </encoder>
  </appender>

  <logger name="gameplay" level="INFO" additivity="false">
    <appender-ref ref="GAMEPLAY" />
  </logger>

  <root level="DEBUG">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="GAMEPLAY_PROBLEMS" />
  </root>

  <logger name="io.netty" level="warn" additivity="false" />
  <logger name="org.flywaydb.core" level="warn" additivity="false" />
  <logger name="org.openrs2.compress.bzip2" level="warn" additivity="false" />
</configuration>
